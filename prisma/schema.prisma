generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One installed copy of the app (your iPhone). No login needed for a personal app.
model Device {
  id          String    @id
  timezone    String    @default("Africa/Cairo")
  intervalMin Int       @default(60)
  startHour   Int       @default(9)
  endHour     Int       @default(22)
  goalMl      Int       @default(2500)
  glassMl     Int       @default(250)
  enabled     Boolean   @default(true)
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())

  subscriptions PushSubscription[]
  logs          WaterLog[]
  supplements   Supplement[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model WaterLog {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  amountMl  Int
  createdAt DateTime @default(now())

  @@index([deviceId, createdAt])
}

/// Something taken on a daily schedule (a vitamin, a pill) — independent of water tracking.
model Supplement {
  id          String    @id @default(cuid())
  deviceId    String
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  name        String
  timeOfDay   String    // "HH:MM", 24h, in the device's local time zone
  enabled     Boolean   @default(true)
  lastNudgeAt DateTime?
  nudgesToday Int       @default(0)
  createdAt   DateTime  @default(now())

  logs SupplementLog[]

  @@index([deviceId])
}

model SupplementLog {
  id           String     @id @default(cuid())
  supplementId String
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  deviceId     String
  takenAt      DateTime   @default(now())

  @@index([supplementId, takenAt])
  @@index([deviceId, takenAt])
}

/// Single-row table: system-wide facts, not tied to any one device.
model AppMeta {
  id         String    @id @default("singleton")
  lastCronAt DateTime?
}
